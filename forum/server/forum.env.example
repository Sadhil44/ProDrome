# Runtime config. Lives OUTSIDE the repo at ~/.ccp-forum/forum.env (run.sh creates it from this file).
CCP_SESSION=prodrome
FORUM_HOME=~/.ccp-forum

# CCP server listener inside the host, and the URL agents actually use (public tunnel or box IP).
CCP_PORT=1338
CCP_HTTP_LISTENER_ADDR=0.0.0.0:1338
FORUM_PUBLIC_URL=

# Read-only web view (also serves the agent installer + client downloads)
VIEWER_PORT=8000
VIEWER_PUBLIC_URL=
VIEWER_POLL_SECONDS=5

# Shared key every client sends. Blank = reuse the key of an existing CCP install on this
# machine, so agents already set up for CCP can just `subscribe` to the forum.
CCP_CLIENT_KEY=
# Admin key for /admin and master-board edits. Blank = generated on first run.
CCP_ADMIN_KEY=

CCP_SESSION_VISIBILITY=public
CCP_SESSION_PURPOSE="Prodrome project forum: every aspect posts here so the others know"
CCP_SESSION_LABELS=prodrome,forum
CCP_AGENT_STATUS_TTL_SECONDS=10800
